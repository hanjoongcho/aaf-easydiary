<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        style="@style/AppCard"
        app:cardCornerRadius="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.simplemobiletools.commons.views.MyTextView
                android:id="@+id/text_description"
                style="@style/SettingsSummary"
                android:text="@string/backup_full_password_description"
                tools:text="Enter a password to encrypt the backup file. Leave it empty to back up without a password." />

            <!--
                The backup password is not kept in the saved instance state and is kept away from autofill, so that
                neither the system nor a password manager stores a secret that cannot be recovered.
            -->
            <com.simplemobiletools.commons.views.MyEditText
                android:id="@+id/edit_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/medium_margin"
                android:hint="@string/backup_full_password_hint"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingTop="0dp"
                android:saveEnabled="false"
                tools:text="password" />

            <com.simplemobiletools.commons.views.MyEditText
                android:id="@+id/edit_password_confirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/medium_margin"
                android:hint="@string/backup_full_password_confirm_hint"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingTop="0dp"
                android:saveEnabled="false"
                tools:text="password" />

            <com.simplemobiletools.commons.views.MyTextView
                android:id="@+id/text_mismatch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/medium_margin"
                android:text="@string/backup_full_password_mismatch"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</ScrollView>
